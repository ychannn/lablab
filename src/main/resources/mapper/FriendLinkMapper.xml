<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.ychan.lablab.mapper.FriendLinkMapper">

    <resultMap id="BaseResultMap" type="org.ychan.lablab.entity.config.FriendLink">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="url" property="url"/>
        <result column="sort" property="sort"/>
        <result column="enabled" property="enabled"/>
    </resultMap>

    <select id="selectEnabledLinks" resultMap="BaseResultMap">
        SELECT * FROM friend_links
        WHERE enabled = true
        ORDER BY sort DESC, id DESC
    </select>

</mapper>